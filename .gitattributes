# Heavy source art goes through Git LFS (see CLAUDE.md). Converted .glb props and textures
# are small enough to live in plain git for now.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Unity text assets: keep them as text with LF endings.
*.cs text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.prefab text eol=lf
*.json text eol=lf
